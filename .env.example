# 站点地址（CORS / RSS / OG 用）
SITE_URL=http://localhost:4321
ADMIN_URL=http://localhost:5173

# 接口层
SERVER_PORT=8787

# 数据与内容目录（默认相对仓库根）
DATA_DIR=./data
CONTENT_DIR=./content
DATABASE_PATH=./data/taoran.db

# 会话与鉴权（M4 启用；用 scripts/hash-password 生成）
SESSION_SECRET=change-me
ADMIN_PASSWORD_HASH=

# WebAuthn（M4 启用）
RP_ID=localhost
RP_ORIGIN=http://localhost:5173

# 重建命令（M3 启用）
REBUILD_CMD=pnpm turbo build --filter=@taoran/web
