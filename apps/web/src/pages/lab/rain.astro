---
import Base from "../../layouts/Base.astro";
import { ClayRain } from "../../islands/ClayRain";
---

<Base title="泥点雨 · 陶然">
  <main>
    <p class="crumb"><a href="/lab/">← 实验室</a></p>
    <h1>泥点雨</h1>
    <p class="intro">
      十万颗泥点的 compute shader 玩具——每颗的运动每帧都在 GPU 上现算，手写 WGSL。纯炫技位，只对 WebGPU 开放。
    </p>
    <ClayRain client:load />
  </main>
</Base>

<style>
  main {
    max-width: 52rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    text-align: center;
  }
  .crumb {
    text-align: left;
    margin: 0 0 1rem;
  }
  .crumb a {
    color: var(--clay-ink-2);
    text-decoration: none;
  }
  h1 {
    color: var(--clay-primary-deep);
    margin: 0;
  }
  .intro {
    color: var(--clay-ink-2);
    max-width: 36em;
    margin: 0.75rem auto 2rem;
  }
</style>

<style is:global>
  /* ClayRain 岛屿（React 内部类名，需全局作用域） */
  .rain-canvas {
    width: min(760px, 92vw);
    aspect-ratio: 16 / 10;
    margin: 0 auto;
    border-radius: var(--clay-r-lg);
    overflow: hidden;
    background: var(--clay-surface);
    box-shadow: var(--clay-elev-pressed);
    touch-action: none;
  }
  .rain-hint {
    color: var(--clay-ink-2);
    font-size: 0.85rem;
    font-family: var(--font-display);
    margin-top: 1rem;
  }

  /* 查看源码折叠块 */
  .rain-source {
    max-width: 760px;
    margin: 1.5rem auto 0;
    text-align: left;
  }
  .rain-source summary {
    cursor: pointer;
    list-style: none;
    color: var(--clay-primary-deep);
    font-family: var(--font-display);
  }
  .rain-source summary::-webkit-details-marker {
    display: none;
  }
  .rain-source summary::before {
    content: "▸ ";
  }
  .rain-source[open] summary::before {
    content: "▾ ";
  }
  .rain-source-label {
    color: var(--clay-ink-2);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin: 1rem 0 0.3rem;
  }
  .rain-source pre {
    margin: 0;
    padding: 1rem;
    border-radius: var(--clay-r-md);
    background: var(--clay-surface);
    box-shadow: var(--clay-elev-pressed);
    overflow: auto;
    max-height: 320px;
  }
  .rain-source code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    white-space: pre;
    color: var(--clay-ink);
  }

  /* 非 T0 降级说明卡 */
  .rain-fallback {
    max-width: 36rem;
    margin: 1rem auto 0;
    text-align: center;
  }
  .rain-fallback-emoji {
    font-size: 2.5rem;
    margin: 0;
  }
  .rain-fallback h2 {
    color: var(--clay-primary-deep);
    margin: 0.5rem 0;
  }
  .rain-fallback p {
    color: var(--clay-ink-2);
  }
  .rain-video-slot {
    margin: 1.5rem auto 0;
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    padding: 1rem;
    border: 2px dashed var(--clay-line);
    border-radius: var(--clay-r-lg);
    color: var(--clay-ink-2);
    font-family: var(--font-display);
  }
</style>
