---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { ClayHero } from "../islands/ClayHero";
import { loadMoments } from "../lib/moments";
import site from "../../../../content/site.json";

const posts = (await getCollection("posts", (p) => p.data.status === "published")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = posts.find((p) => p.data.pinned) ?? posts[0];
const latest = posts.filter((p) => p !== featured).slice(0, 4);

const tagCount = new Map<string, number>();
for (const post of posts) for (const t of post.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const topTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);

const moments = loadMoments().slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString("zh-CN", { month: "long", day: "numeric" });
---

<Base>
  <main>
    <section class="hero">
      <div class="hero-text">
        <h1>{site.name}</h1>
        <p class="tagline">{site.tagline}</p>
        <p class="intro">一团温暖的粘土博客：写前端、设计与生活。页面上的东西都可以捏。</p>
        <p class="cta">
          <a class="clay-btn" data-variant="primary" href="/posts/">开始阅读</a>
          <a class="clay-btn" data-variant="soft" href="/about/">关于我</a>
        </p>
      </div>
      <div class="hero-clay">
        <ClayHero client:visible />
      </div>
    </section>

    {
      featured && (
        <section class="featured reveal">
          <h2 class="sec-title">置顶</h2>
          <a class="clay-card featured-card" data-hoverable="true" href={`/posts/${featured.data.slug}/`}>
            {featured.data.cover && (
              <Image src={featured.data.cover} alt="" widths={[480, 960]} sizes="(max-width: 768px) 100vw, 420px" />
            )}
            <div>
              <h3>{featured.data.title}</h3>
              <p>{featured.data.summary}</p>
              <p class="meta">{fmt(featured.data.date)}</p>
            </div>
          </a>
        </section>
      )
    }

    <section>
      <h2 class="sec-title">最新</h2>
      <div class="latest-grid">
        {
          latest.map((post, i) => (
            <a class="clay-card post-card reveal" style={`--i:${i}`} data-hoverable="true" href={`/posts/${post.data.slug}/`}>
              <h3>{post.data.title}</h3>
              <p>{post.data.summary}</p>
              <p class="meta">{fmt(post.data.date)}</p>
            </a>
          ))
        }
      </div>
      <p class="more">
        <a href="/archive/">看全部归档 →</a>
      </p>
    </section>

    <section>
      <h2 class="sec-title">标签</h2>
      <p class="tag-cloud">
        {
          topTags.map(([tag, count]) => (
            <a class="clay-tag-link" href={`/tags/${tag}/`}>
              #{tag} <small>{count}</small>
            </a>
          ))
        }
      </p>
    </section>

    <section>
      <h2 class="sec-title">最近动态</h2>
      <div class="moments">
        {
          moments.map((m, i) => (
            <div class="clay-card moment reveal" style={`--i:${i}; --tilt:${(i % 2 === 0 ? 1 : -1) * 0.6}deg`}>
              <p>{m.mood && <span class="mood">{m.mood}</span>} {m.text}</p>
              <p class="meta">{fmt(m.createdAt)}</p>
            </div>
          ))
        }
      </div>
      <p class="more">
        <a href="/moments/">更多动态 →</a>
      </p>
    </section>
  </main>
</Base>

<style>
  main {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .sec-title {
    font-size: 1.1rem;
    color: var(--clay-ink-2);
    border-bottom: 2px dashed var(--clay-line);
    padding-bottom: 0.4rem;
    margin-top: 3.5rem;
  }

  /* hero */
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 2rem;
    min-height: 50vh;
  }
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
  .hero h1 {
    font-size: 3.5rem;
    margin: 0;
    color: var(--clay-primary-deep);
  }
  .tagline {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--clay-ink-2);
  }
  .intro {
    max-width: 30em;
  }
  .cta {
    display: flex;
    gap: 1rem;
  }
  .cta .clay-btn {
    text-decoration: none;
  }
  .hero-clay {
    text-align: center;
  }

  /* featured + latest */
  .featured-card {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 1.5rem;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  @media (max-width: 640px) {
    .featured-card {
      grid-template-columns: 1fr;
    }
  }
  .featured-card img {
    width: 100%;
    height: auto;
    border-radius: var(--clay-r-md);
    box-shadow: var(--clay-elev-pressed);
  }
  .featured-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.4rem;
  }
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .post-card {
    color: inherit;
    text-decoration: none;
  }
  .post-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }
  .meta {
    color: var(--clay-ink-2);
    font-size: 0.85rem;
    margin-bottom: 0;
  }
  .more {
    margin-top: 1.5rem;
    text-align: right;
  }

  /* tags */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .clay-tag-link {
    background: var(--clay-surface);
    box-shadow: var(--clay-elev-pressed);
    border-radius: 999px;
    padding: 0.25em 1em;
    text-decoration: none;
    color: var(--clay-ink);
    transition: transform var(--mo-fast) var(--mo-ease-squish), box-shadow var(--mo-fast) var(--mo-ease-out);
  }
  .clay-tag-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--clay-elev-rest);
  }
  .clay-tag-link small {
    color: var(--clay-ink-2);
  }

  /* moments：便签泥片，随机 ±1° 旋转（docs/05-site-web.md §2.5） */
  .moments {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .moment {
    rotate: var(--tilt, 0.5deg);
  }
  .moment p:first-child {
    margin-top: 0;
  }
  .mood {
    font-size: 1.2em;
    margin-right: 0.25em;
  }
</style>

<style is:global>
  /* ClayHero 岛屿（React 内部类名，需全局作用域） */
  .clay-hero {
    position: relative;
    text-align: center;
  }
  .clay-hero-canvas {
    width: min(340px, 72vw);
    aspect-ratio: 1;
    margin: 0 auto;
  }
  .clay-hero-canvas[data-state="loading"],
  .clay-hero-canvas[data-state="static"] {
    display: none;
  }
  .clay-hero-blob {
    width: min(220px, 50vw);
    aspect-ratio: 1;
    margin: 2rem auto;
    background: var(--clay-primary);
    border-radius: var(--clay-r-blob);
    box-shadow: var(--clay-elev-raised);
    animation: blob-breathe 7s ease-in-out infinite;
  }
  @keyframes blob-breathe {
    0%, 100% { border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; }
    33% { border-radius: 55% 45% 35% 65% / 50% 60% 40% 50%; }
    66% { border-radius: 40% 60% 60% 40% / 60% 40% 60% 40%; }
  }
  .clay-hero-hint {
    color: var(--clay-ink-2);
    font-size: 0.8rem;
    font-family: var(--font-display);
  }
</style>
