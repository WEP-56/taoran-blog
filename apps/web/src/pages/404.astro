---
import Base from "../layouts/Base.astro";
import { BrokenPot } from "../islands/BrokenPot";
---

<Base title="404 · 陶然">
  <main>
    <BrokenPot client:load />
    <h1>404 · 这页泥还没捏</h1>
    <p>地址可能拼错了，或者文章已经回炉。</p>
    <p class="cta">
      <a class="clay-btn" data-variant="primary" href="/">回首页</a>
      <button class="clay-btn" data-variant="soft" type="button" data-open-search>搜一搜</button>
    </p>
  </main>
</Base>

<style>
  main {
    max-width: 36rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
    text-align: center;
  }
  h1 {
    color: var(--clay-primary-deep);
  }
  .cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }
  .cta .clay-btn {
    text-decoration: none;
  }
</style>

<style is:global>
  .pot-stage {
    position: relative;
    height: 280px;
    overflow: hidden;
    touch-action: none;
    user-select: none;
  }
  .pot-ghost {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 190px;
    height: 130px;
    border: 3px dashed var(--clay-line);
    border-radius: 40% 40% 55% 55% / 35% 35% 70% 70%;
    transition: opacity var(--mo-slow) var(--mo-ease-out);
  }
  .pot-shard {
    position: absolute;
    left: 50%;
    top: 50%;
    background: var(--clay-primary);
    box-shadow: var(--clay-elev-rest);
    cursor: grab;
    will-change: transform;
  }
  .pot-shard:active {
    cursor: grabbing;
  }
  .pot-scene[data-restored="true"] .pot-ghost {
    opacity: 0;
  }
  .pot-whole {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -54%;
    font-size: 7rem;
    animation: pot-bow 0.9s var(--mo-ease-squish);
  }
  @keyframes pot-bow {
    0% { scale: 0.6; rotate: -8deg; }
    55% { scale: 1.12; rotate: 4deg; }
    100% { scale: 1; rotate: 0deg; }
  }
  .pot-scene[data-restored="true"] .pot-shard {
    opacity: 0;
    transition: opacity var(--mo-base) var(--mo-ease-out);
  }
  .pot-caption {
    color: var(--clay-ink-2);
    font-family: var(--font-display);
  }
</style>
